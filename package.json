{
  "name": "pob-mcp-server",
  "version": "1.0.1",
  "description": "MCP server for Path of Building integration",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "generate:item-format": "node scripts/generate-item-format.mjs",
    "generate:item-format:check": "node scripts/generate-item-format.mjs --check",
    "generate:item-oracle": "node scripts/generate-item-oracle.mjs",
    "generate:item-oracle:check": "node scripts/generate-item-oracle.mjs --check",
    "dossier:tree": "node scripts/dossier-tree.mjs",
    "start": "node build/index.js",
    "trade:mcp": "node build/trade/mcp.js",
    "trade:open": "powershell.exe -NoProfile -File apps/trade-desktop/Start-Trade.ps1",
    "trade:stop": "node build/trade/launcher.js --stop",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:smoke": "node tests/smoke/bridge.mjs && node tests/smoke/mcp.mjs",
    "test:smoke:offline": "node tests/smoke/lua-client-race.mjs && node tests/smoke/persistence.mjs && node tests/smoke/state-truthfulness.mjs",
    "test:smoke:full": "node tests/smoke/mcp-full.mjs",
    "test:smoke:weighted": "POE_WEIGHTED_SMOKE=true node tests/smoke/mcp.mjs",
    "test:smoke:trade": "node tests/smoke/trade-mcp.mjs",
    "test:smoke:local-trade": "node tests/smoke/local-trade.mjs && node tests/smoke/local-trade-app.mjs && node tests/smoke/local-trade-app.mjs --live-fixture && node tests/smoke/integration-settings.mjs && node --test tests/smoke/local-trade-pob.mjs tests/smoke/electron-session.test.cjs tests/smoke/live-search-browser-auth.mjs",
    "test:smoke:assistant": "node tests/smoke/assistant-codex-compat.mjs --real",
    "test:smoke:crafting": "node tests/smoke/crafting-mcp.mjs",
    "test:smoke:persistence": "node tests/smoke/persistence.mjs",
    "test:smoke:race": "node tests/smoke/lua-client-race.mjs",
    "test:smoke:truthfulness": "node tests/smoke/state-truthfulness.mjs",
    "test:smoke:dossier": "node tests/smoke/dossier-tree.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bottleneck": "^2.19.5",
    "chokidar": "^4.0.3",
    "fast-xml-parser": "^5.10.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "electron": "45.3.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11"
  }
}
